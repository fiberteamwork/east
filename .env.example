CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/webgis/'

# Laragon MySQL defaults. Replace these with the database credentials from
# your hosting control panel when deploying, and keep the real .env private.
database.default.hostname = '127.0.0.1'
database.default.port = 3306
database.default.database = 'webgis'
database.default.username = 'root'
database.default.password = ''
